# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure scripts and markdown use LF
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows command and batch files require CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
