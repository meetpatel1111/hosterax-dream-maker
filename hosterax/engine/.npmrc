# No dependency of the engine needs an install script: better-sqlite3 ships prebuilt binaries for
# every platform it supports. Without this, an install that follows the lockfile still runs
# `node-gyp rebuild` for it (a lockfile cannot record the package's `gypfile: false`), which needs a
# C++ toolchain and fails on Windows runners whose Visual Studio node-gyp does not recognise.
ignore-scripts=true
